{
  "permissions": {
    "deny": [
      "Bash(git push --force *)"
    ],
    "ask": [
      "Edit(/PROJECT.md)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/session_start.sh"
          }
        ]
      }
    ]
  }
}
